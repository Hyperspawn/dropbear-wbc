# Copy to .dropbear.env (untracked) and edit for your machine. Every key is optional: environment variables win,
# and the defaults below (relative to this repository) are used for anything left out.
# `python -m dropbear_wbc.paths` (with source/ on PYTHONPATH) prints what is resolved.

# Plant USD (421 MB; `python tools/fetch_assets.py` downloads it to assets/dropbear.usd, the default)
# DROPBEAR_USD=assets/dropbear.usd

# Isaac Sim 5.0 install (Windows default C:/isaac-sim; Linux default ~/isaacsim) and its python launcher
# ISAAC_SIM_ROOT=C:/isaac-sim
# ISAACSIM_PYTHON=C:/isaac-sim/python.bat

# External clones used by the motion pipeline (GMR, unitree_mujoco, lafan1, GR00T-WholeBodyControl); default ../upstream
# DROPBEAR_UPSTREAM=../upstream

# github.com/robit-man/dropbear_control (deploy-side Newton/MuJoCo plant adapter); default ../dropbear_control
# DROPBEAR_CONTROL_DIR=../dropbear_control

# Hugging Face cache for Kimodo-G1 and the LLM2Vec / Llama-3 text encoder (~17 GB); default $HF_HOME or ~/.cache/huggingface
# DROPBEAR_HF_CACHE=D:/hf_cache

# ffmpeg for videos (default: on PATH, else the one bundled with Isaac Sim)
# DROPBEAR_FFMPEG=ffmpeg
