* text=auto
*.sh text eol=lf
*.py text eol=lf
# Data is pinned by SHA-256 (calibration files, library manifests, clip sidecars, serial model): store the exact bytes.
data/** -text
logs/** -text
tests/fixtures/** -text
site/data/** -text
assets_manifest.json -text
# Serial MJCF/URDF/JSON surrogates are byte-compared in tests/test_serial_hw_actuators.py. Force LF in the
# working tree even under core.autocrlf=true (overrides data/** -text for these extensions).
data/robot/*.json text eol=lf
data/robot/*.xml text eol=lf
data/robot/*.urdf text eol=lf
*.npz binary
*.glb binary
*.bin binary
*.jpg binary
*.png binary
*.stl binary
